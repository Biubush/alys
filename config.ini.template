# 阿里云盘同步系统配置文件
# 请复制此文件为 config.ini 并修改相应配置

[database]
# 数据库配置
host = localhost
port = 5432
username = aliyundrive
password = your_secure_password
database = aliyundrive_sync
# 或者使用完整URL连接字符串
# url = postgresql://aliyundrive:your_secure_password@localhost/aliyundrive_sync

[redis]
# Redis配置
host = localhost
port = 6379
db = 0
# 或者使用完整URL连接字符串
# url = redis://localhost:6379/0

[security]
# 安全配置
secret_key = your_secret_key_here
jwt_secret_key = your_jwt_secret_key
jwt_algorithm = HS256
jwt_access_token_expire_minutes = 30
jwt_refresh_token_expire_days = 7

[mail]
# 邮件服务配置
server = smtp.example.com
port = 587
username = your_email@example.com
password = your_email_password
from_address = noreply@example.com
tls = True
ssl = False

[task]
# 任务配置
max_tasks_per_user = 10
max_concurrent_tasks = 5
default_task_timeout = 3600
retry_count = 3
retry_interval = 300

[server]
# 服务器配置
host = 0.0.0.0
port = 8000
workers = 4
debug = False

[admin]
# 管理员初始账户设置（仅首次启动时使用）
username = admin
email = admin@example.com
password = ChangeThisSecurePassword!

[aliyundrive]
# 阿里云盘相关配置
refresh_token_interval = 86400  # 令牌刷新间隔，单位秒 